#!/bin/bash
# claudep — Claude Private Edition with automatic document-to-markdown conversion
#
# Drop-in replacement for claude / claude-private. When used with -p and a
# prompt that references document files (PDF, DOCX, PPTX, etc.), claudep
# automatically converts them to markdown first — saving tokens and cost.
#
# No telemetry. Token-efficient document ingestion.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Telemetry kill switches (inherited from claude-private)
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
export DISABLE_TELEMETRY=1
export DISABLE_AUTOUPDATER=1
export CLAUDE_CODE_ENABLE_TELEMETRY=0
export OTEL_METRICS_EXPORTER=none
export OTEL_LOGS_EXPORTER=none
export OTEL_TRACES_EXPORTER=none

# Document extensions to auto-convert
DOC_PATTERN='\.(pdf|docx|doc|rtf|odt|pptx|ppt|odp|epub|pages|key)$'

# PDF page threshold: PDFs with more pages than this skip conversion
# and use native API ingestion instead (more efficient for large PDFs).
# Set to 0 to disable the threshold (always convert).
CLAUDEP_MAX_PDF_PAGES="${CLAUDEP_MAX_PDF_PAGES:-5}"

# Locate the doc2md converter
DOC2MD="$SCRIPT_DIR/doc2md"
if [[ ! -x "$DOC2MD" ]]; then
    DOC2MD="$(dirname "$SCRIPT_DIR")/doc2md"
fi

# Locate the base binary (claude-notelemetry from claude-private install)
CLAUDE_BIN=""
for candidate in \
    "$HOME/.local/bin/claude-notelemetry" \
    "$SCRIPT_DIR/claude-notelemetry" \
    "$(which claude-notelemetry 2>/dev/null)"; do
    if [[ -x "$candidate" ]]; then
        CLAUDE_BIN="$candidate"
        break
    fi
done

if [[ -z "$CLAUDE_BIN" ]]; then
    echo "Error: claude-notelemetry binary not found." >&2
    echo "Install claude-private first, or place claude-notelemetry in PATH." >&2
    exit 1
fi

# --- Auto-convert documents referenced in -p prompts ---
# Scan arguments for -p/--print flag and look for file paths in the prompt
CONVERTED_FILES=()
TMPDIR=""
NEW_ARGS=()
CONVERT_MODE=1  # Auto-convert by default
PROMPT_TEXT=""
PROMPT_INDEX=-1  # Position in NEW_ARGS where prompt placeholder is
NEXT_IS_PROMPT=0

for arg in "$@"; do
    if [[ "$arg" == "--no-convert" ]]; then
        CONVERT_MODE=0
        continue
    fi

    if [[ $NEXT_IS_PROMPT -eq 1 ]]; then
        PROMPT_TEXT="$arg"
        NEXT_IS_PROMPT=0
        # Insert placeholder — will be replaced with final prompt
        PROMPT_INDEX=${#NEW_ARGS[@]}
        NEW_ARGS+=("__PROMPT_PLACEHOLDER__")
        continue
    fi

    if [[ "$arg" == "-p" || "$arg" == "--print" ]]; then
        NEXT_IS_PROMPT=1
        NEW_ARGS+=("$arg")
        continue
    fi

    NEW_ARGS+=("$arg")
done

# Process prompt: scan for document paths and convert
FINAL_PROMPT="$PROMPT_TEXT"
if [[ -n "$PROMPT_TEXT" && "$CONVERT_MODE" -eq 1 && -x "$DOC2MD" ]]; then
    while IFS= read -r filepath; do
        [[ -z "$filepath" ]] && continue
        expanded="${filepath/#\~/$HOME}"

        if [[ -f "$expanded" ]] && echo "$expanded" | grep -qiE "$DOC_PATTERN"; then
            if [[ -z "$TMPDIR" ]]; then
                TMPDIR=$(mktemp -d /tmp/claudep.XXXXXX)
            fi

            BASENAME="$(basename "$expanded")"
            EXT="${BASENAME##*.}"
            NAME="${BASENAME%.*}"
            MD_FILE="$TMPDIR/${NAME}.md"

            echo "[claudep] Converting: $expanded" >&2
            "$DOC2MD" --max-pdf-pages "$CLAUDEP_MAX_PDF_PAGES" "$expanded" "$MD_FILE" >&2 2>&1
            DOC2MD_EXIT=$?
            if [[ $DOC2MD_EXIT -eq 0 ]]; then
                FINAL_PROMPT="${FINAL_PROMPT//$filepath/$MD_FILE}"
                CONVERTED_FILES+=("$MD_FILE")
            elif [[ $DOC2MD_EXIT -eq 2 ]]; then
                echo "[claudep] Large PDF — using native API ingestion (faster for 5+ pages)" >&2
            else
                echo "[claudep] Warning: conversion failed for $expanded, using original" >&2
            fi
        fi
    done < <(python3 -c "
import re, sys
text = sys.argv[1]
# Match file paths: /path/to/file.ext or ~/path/to/file.ext
# Handles spaces in filenames when quoted or between path separators
exts = r'\.(pdf|docx|doc|rtf|odt|pptx|ppt|odp|epub|pages|key)'
# Try quoted paths first (handles spaces)
for m in re.finditer(r'\"([^\"]+' + exts + r')\"', text):
    print(m.group(1))
# Then unquoted absolute paths (no spaces)
for m in re.finditer(r'(?<![\"a-zA-Z])(/[^ \"]+' + exts + r')', text):
    print(m.group(1))
# Then ~/paths
for m in re.finditer(r'(~/[^ \"]+' + exts + r')', text):
    print(m.group(1))
" "$PROMPT_TEXT" 2>/dev/null | sort -u)
fi

# Replace the placeholder with the final prompt
if [[ $PROMPT_INDEX -ge 0 ]]; then
    NEW_ARGS[$PROMPT_INDEX]="$FINAL_PROMPT"
fi

# Cleanup on exit
cleanup() {
    if [[ -n "$TMPDIR" && -d "$TMPDIR" ]]; then
        rm -rf "$TMPDIR"
    fi
}
trap cleanup EXIT

# Run claude
exec "$CLAUDE_BIN" "${NEW_ARGS[@]}"
